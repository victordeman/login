# Database connection string (PostgreSQL)
# For local development, you can use: postgresql://USER:PASSWORD@localhost:5432/DATABASE
# For production (Vercel), we recommend using Neon (https://neon.tech) with connection pooling.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Upstash Redis configuration
# Get these from your Upstash console: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# JWT Secret for session signing
# You can generate a secure one with: openssl rand -base64 32
SESSION_SECRET="your-secret-key-at-least-32-characters-long"
